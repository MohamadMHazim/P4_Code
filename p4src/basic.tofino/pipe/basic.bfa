parser ingress:
  start: $entry_point.start
  init_zero: [ H1, B3, H4, H5, H6, B1, B0, B2 ]
  bitwise_or: [ B2 ]
  hdr_len_adj: 16
  states:
    $entry_point.start:
      *:
        0..1: H2  # bit[7..15] -> H2 bit[8..0]: ingress::ig_intr_md.ingress_port
        16..17: TH13  # ingress::hdr.ethernet.dst_addr[47:32].32-47
        18: TB7  # ingress::hdr.ethernet.dst_addr[31:24].24-31
        19: TB6  # ingress::hdr.ethernet.dst_addr[23:16].16-23
        20: TB5  # ingress::hdr.ethernet.dst_addr[15:8].8-15
        21: TB4  # ingress::hdr.ethernet.dst_addr[7:0].0-7
        22..23: TH12  # ingress::hdr.ethernet.src_addr[47:32].32-47
        24..25: TH11  # ingress::hdr.ethernet.src_addr[31:16].16-31
        load: { half : 28..29 }
        shift: 26
        buf_req: 30
        next: $entry_point.start.$split_0
    $entry_point.start.$split_0:
      match: [ half ]
      0x0800:
        0..1: TH10  # ingress::hdr.ethernet.src_addr[15:0].0-15
        2..3: H3  # ingress::hdr.ethernet.ether_type
        B2: 1  # value 1 -> B2 bit[0]: ingress::hdr.ethernet.$valid
        shift: 4
        buf_req: 4
        next: parse_ipv4
      0x86dd:
        0..1: TH10  # ingress::hdr.ethernet.src_addr[15:0].0-15
        2..3: H3  # ingress::hdr.ethernet.ether_type
        B2: 1  # value 1 -> B2 bit[0]: ingress::hdr.ethernet.$valid
        shift: 4
        buf_req: 4
        next: parse_ipv6
      0x****:
        0..1: TH10  # ingress::hdr.ethernet.src_addr[15:0].0-15
        2..3: H3  # ingress::hdr.ethernet.ether_type
        B2: 1  # value 1 -> B2 bit[0]: ingress::hdr.ethernet.$valid
        shift: 4
        buf_req: 4
        next: end
    parse_ipv4:
      *:
        0..3: TW4
            # - bit[0..3] -> TW4 bit[31..28]: ingress::hdr.ipv4.version
            # - bit[4..7] -> TW4 bit[27..24]: ingress::hdr.ipv4.ihl
            # - bit[8..15] -> TW4 bit[23..16]: ingress::hdr.ipv4.diffserv
            # - bit[16..31] -> TW4 bit[15..0]: ingress::hdr.ipv4.total_len
        2..3: H1  # ingress::meta.pkt_len
        4..7: TW7
            # - bit[32..47] -> TW7 bit[31..16]: ingress::hdr.ipv4.identification
            # - bit[48..50] -> TW7 bit[15..13]: ingress::hdr.ipv4.flags
            # - bit[51..63] -> TW7 bit[12..0]: ingress::hdr.ipv4.frag_offset
        8..11: TW6
            # - bit[64..71] -> TW6 bit[31..24]: ingress::hdr.ipv4.ttl
            # - bit[72..79] -> TW6 bit[23..16]: ingress::hdr.ipv4.protocol
            # - bit[80..95] -> TW6 bit[15..0]: ingress::hdr.ipv4.hdr_checksum
        9: B3  # ingress::meta.sel_protocol
        12..15: TW9  # ingress::hdr.ipv4.src_addr
        B2: 2  # value 1 -> B2 bit[1]: ingress::hdr.ipv4.$valid
        load: { byte1 : 9 }
        shift: 16
        buf_req: 16
        next: parse_ipv4.$split_0
    parse_ipv4.$split_0:
      match: [ byte1 ]
      0x06:
        0..3: TW8  # ingress::hdr.ipv4.dst_addr
        4..5: TH9  # ingress::hdr.tcp.sport
        4..5: H4  # ingress::meta.sel_src_port
        6..7: TH8  # ingress::hdr.tcp.dport
        6..7: H5  # ingress::meta.sel_dst_port
        8..11: TW11  # ingress::hdr.tcp.seq
        12..15: TW10  # ingress::hdr.tcp.ack
        16..19: TW5
            # - bit[96..99] -> TW5 bit[31..28]: ingress::hdr.tcp.dataofs
            # - bit[100..103] -> TW5 bit[27..24]: ingress::hdr.tcp.reserved
            # - bit[104..111] -> TW5 bit[23..16]: ingress::hdr.tcp.flags
            # - bit[112..127] -> TW5 bit[15..0]: ingress::hdr.tcp.window
        B2: 4  # value 1 -> B2 bit[2]: ingress::hdr.tcp.$valid
        shift: 20
        buf_req: 20
        next: parse_tcp.$split_0
      0x11:
        0..3: TW8  # ingress::hdr.ipv4.dst_addr
        4..5: TH7  # ingress::hdr.udp.sport
        4..5: H4  # ingress::meta.sel_src_port
        6..7: TH6  # ingress::hdr.udp.dport
        6..7: H5  # ingress::meta.sel_dst_port
        8..11: TW5
            # - bit[32..47] -> TW5 bit[31..16]: ingress::hdr.udp.len
            # - bit[48..63] -> TW5 bit[15..0]: ingress::hdr.udp.chksum
        B2: 8  # value 1 -> B2 bit[3]: ingress::hdr.udp.$valid
        shift: 12
        buf_req: 12
        next: end
      0x**:
        0..3: TW8  # ingress::hdr.ipv4.dst_addr
        shift: 4
        buf_req: 4
        next: end
    parse_tcp.$split_0:
      *:
        0..1: TH7  # ingress::hdr.tcp.chksum
        2..3: TH6  # ingress::hdr.tcp.urgptr
        shift: 4
        buf_req: 4
        next: end
    parse_ipv6:
      *:
        4..5: H1  # ingress::meta.pkt_len
        6: B3  # ingress::meta.sel_protocol
        B2: 16  # value 1 -> B2 bit[4]: ingress::hdr.ipv6.$valid
        load: { byte1 : 6 }
        shift: 32
        buf_req: 32
        next: parse_ipv6.$stall_0
    parse_ipv6.$stall_0:
      match: [ byte1 ]
      0x06:
        8..9: TH9  # ingress::hdr.tcp.sport
        8..9: H4  # ingress::meta.sel_src_port
        10..11: TH8  # ingress::hdr.tcp.dport
        10..11: H5  # ingress::meta.sel_dst_port
        12..15: TW11  # ingress::hdr.tcp.seq
        16..19: TW10  # ingress::hdr.tcp.ack
        20..23: TW5
            # - bit[96..99] -> TW5 bit[31..28]: ingress::hdr.tcp.dataofs
            # - bit[100..103] -> TW5 bit[27..24]: ingress::hdr.tcp.reserved
            # - bit[104..111] -> TW5 bit[23..16]: ingress::hdr.tcp.flags
            # - bit[112..127] -> TW5 bit[15..0]: ingress::hdr.tcp.window
        B2: 4  # value 1 -> B2 bit[2]: ingress::hdr.tcp.$valid
        shift: 24
        buf_req: 24
        next: parse_tcp.$split_0
      0x11:
        8..9: TH7  # ingress::hdr.udp.sport
        8..9: H4  # ingress::meta.sel_src_port
        10..11: TH6  # ingress::hdr.udp.dport
        10..11: H5  # ingress::meta.sel_dst_port
        12..15: TW5
            # - bit[32..47] -> TW5 bit[31..16]: ingress::hdr.udp.len
            # - bit[48..63] -> TW5 bit[15..0]: ingress::hdr.udp.chksum
        B2: 8  # value 1 -> B2 bit[3]: ingress::hdr.udp.$valid
        shift: 16
        buf_req: 16
        next: end
      0x**:
        shift: 8
        buf_req: 8
        next: end
deparser ingress:
  dictionary:
    TH13: B2(0)  # ingress::hdr.ethernet.dst_addr.32-47 if ingress::hdr.ethernet.$valid
    TB7: B2(0)  # ingress::hdr.ethernet.dst_addr.24-31 if ingress::hdr.ethernet.$valid
    TB6: B2(0)  # ingress::hdr.ethernet.dst_addr.16-23 if ingress::hdr.ethernet.$valid
    TB5: B2(0)  # ingress::hdr.ethernet.dst_addr.8-15 if ingress::hdr.ethernet.$valid
    TB4: B2(0)  # ingress::hdr.ethernet.dst_addr.0-7 if ingress::hdr.ethernet.$valid
    TH12: B2(0)  # ingress::hdr.ethernet.src_addr.32-47 if ingress::hdr.ethernet.$valid
    TH11: B2(0)  # ingress::hdr.ethernet.src_addr.16-31 if ingress::hdr.ethernet.$valid
    TH10: B2(0)  # ingress::hdr.ethernet.src_addr.0-15 if ingress::hdr.ethernet.$valid
    H3: B2(0)  # ingress::hdr.ethernet.ether_type if ingress::hdr.ethernet.$valid
    TW4: B2(1)
        # - bit[31..28]: ingress::hdr.ipv4.version if ingress::hdr.ipv4.$valid
        # - bit[27..24]: ingress::hdr.ipv4.ihl if ingress::hdr.ipv4.$valid
        # - bit[23..16]: ingress::hdr.ipv4.diffserv if ingress::hdr.ipv4.$valid
        # - bit[15..0]: ingress::hdr.ipv4.total_len if ingress::hdr.ipv4.$valid
    TW7: B2(1)
        # - bit[31..16]: ingress::hdr.ipv4.identification if ingress::hdr.ipv4.$valid
        # - bit[15..13]: ingress::hdr.ipv4.flags if ingress::hdr.ipv4.$valid
        # - bit[12..0]: ingress::hdr.ipv4.frag_offset if ingress::hdr.ipv4.$valid
    TW6: B2(1)
        # - bit[31..24]: ingress::hdr.ipv4.ttl if ingress::hdr.ipv4.$valid
        # - bit[23..16]: ingress::hdr.ipv4.protocol if ingress::hdr.ipv4.$valid
        # - bit[15..0]: ingress::hdr.ipv4.hdr_checksum if ingress::hdr.ipv4.$valid
    TW9: B2(1)  # ingress::hdr.ipv4.src_addr if ingress::hdr.ipv4.$valid
    TW8: B2(1)  # ingress::hdr.ipv4.dst_addr if ingress::hdr.ipv4.$valid
    TH9: B2(2)  # ingress::hdr.tcp.sport if ingress::hdr.tcp.$valid
    TH8: B2(2)  # ingress::hdr.tcp.dport if ingress::hdr.tcp.$valid
    TW11: B2(2)  # ingress::hdr.tcp.seq if ingress::hdr.tcp.$valid
    TW10: B2(2)  # ingress::hdr.tcp.ack if ingress::hdr.tcp.$valid
    TW5: B2(2)
        # - bit[31..28]: ingress::hdr.tcp.dataofs if ingress::hdr.tcp.$valid
        # - bit[27..24]: ingress::hdr.tcp.reserved if ingress::hdr.tcp.$valid
        # - bit[23..16]: ingress::hdr.tcp.flags if ingress::hdr.tcp.$valid
        # - bit[15..0]: ingress::hdr.tcp.window if ingress::hdr.tcp.$valid
    TH7: B2(2)  # ingress::hdr.tcp.chksum if ingress::hdr.tcp.$valid
    TH6: B2(2)  # ingress::hdr.tcp.urgptr if ingress::hdr.tcp.$valid
    TH7: B2(3)  # ingress::hdr.udp.sport if ingress::hdr.udp.$valid
    TH6: B2(3)  # ingress::hdr.udp.dport if ingress::hdr.udp.$valid
    TW5: B2(3)
        # - bit[31..16]: ingress::hdr.udp.len if ingress::hdr.udp.$valid
        # - bit[15..0]: ingress::hdr.udp.chksum if ingress::hdr.udp.$valid
  egress_unicast_port: H0(0..8)  # bit[8..0]: ingress::ig_intr_md_for_tm.ucast_egress_port
  bypss_egr: B1(3..3)  # bit[3]: ingress::ig_intr_md_for_tm.bypass_egress
  drop_ctl: B1(0..2)  # bit[2..0]: ingress::ig_intr_md_for_dprsr.drop_ctl
  mirror:
    select: B0(0..2)  # bit[2..0]: ingress::ig_intr_md_for_dprsr.mirror_type
    0:
      - H2(0..9)  # bit[9..0]: ingress::$tmp2
parser egress:
  start: $entry_point.start.min_parse_depth_accept_initial
  init_zero: [ B16 ]
  bitwise_or: [ B16 ]
